<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FunBus</AssemblyName>
    <RootNamespace>FunBus</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Versione mostrata nelle proprietà dell'exe e nell'app. Sovrascrivibile: -p:Version=x.y.z -->
    <Version>1.3.0</Version>
    <FileVersion>$(Version).0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>FunBus</Product>
    <Company>Riccardo Bortolussi</Company>
    <Authors>Riccardo Bortolussi</Authors>
    <Title>FunBus</Title>
    <Description>FunBus - app didattica sui bus di campo e protocolli industriali</Description>
    <Copyright>Copyright (c) Riccardo Bortolussi</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.0" />
  </ItemGroup>

  <!-- Contenuti web incorporati nell'exe; sovrascrivibili dalla cartella "content" accanto all'exe -->
  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <None Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

</Project>
